# Sao chép file này thành `secrets.toml` (cùng thư mục) rồi điền key thật.
# `secrets.toml` đã nằm trong .gitignore — TUYỆT ĐỐI không commit nó.
#
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# ── Gemini (chatbot) ──────────────────────────────────────────────────
# Không có key thì chatbot vẫn chạy bằng engine nội bộ.
# Lấy tại: https://aistudio.google.com/apikey
GEMINI_API_KEY = "dan-key-cua-ban-vao-day"

# ── vnstock (dữ liệu chứng khoán) ─────────────────────────────────────
# Không có key thì dữ liệu giá OHLCV vẫn hoạt động; một số chỉ số nâng cao
# có thể không khả dụng. Lấy tại: https://vnstocks.com/settings
VNSTOCK_API_KEY = "dan-key-cua-ban-vao-day"

# ══════════════════════════════════════════════════════════════════════
# TRIỂN KHAI TRÊN STREAMLIT CLOUD
# File này KHÔNG được đẩy lên. Vào app trên share.streamlit.io:
#   Manage app → Settings → Secrets → dán cùng nội dung (dạng TOML)
# ══════════════════════════════════════════════════════════════════════
