# Sao chép file này thành `secrets.toml` (cùng thư mục) rồi điền key thật.
# `secrets.toml` đã nằm trong .gitignore — TUYỆT ĐỐI không commit nó.
#
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# ── Gemini (chatbot) ──────────────────────────────────────────────────
# Không có key thì chatbot vẫn chạy bằng engine nội bộ.
# Lấy tại: https://aistudio.google.com/apikey
GEMINI_API_KEY = "dan-key-cua-ban-vao-day"

# ── vnstock (dữ liệu chứng khoán) ─────────────────────────────────────
# Không có key thì dữ liệu giá OHLCV vẫn hoạt động; một số chỉ số nâng cao
# có thể không khả dụng. Lấy tại: https://vnstocks.com/settings
VNSTOCK_API_KEY = "dan-key-cua-ban-vao-day"

# ── Google Sheets (kho ngoài cho sổ lệnh) ─────────────────────────────
# VÌ SAO CẦN: ổ đĩa Streamlit Cloud là TẠM. App ngủ khi không dùng,
# redeploy mỗi lần push, và mọi file app tự ghi ra đều mất. Không có kho
# ngoài thì trên cloud sổ lệnh chỉ đọc được, mọi lệnh ghi mới bốc hơi.
#
# Không điền thì tính năng tắt sạch, app chạy bình thường trên máy local.
#
# CÁCH DỰNG (một lần, ~5 phút):
#  1. console.cloud.google.com → tạo project (hoặc dùng project sẵn có)
#  2. APIs & Services → Enable APIs → bật "Google Sheets API" và
#     "Google Drive API"
#  3. IAM & Admin → Service Accounts → Create service account
#     → Keys → Add key → Create new key → JSON → tải file về
#  4. Tạo một Google Sheet mới. Lấy KEY từ URL:
#     docs.google.com/spreadsheets/d/<KEY>/edit
#  5. Bấm Share trên Sheet đó, mời địa chỉ `client_email` trong file JSON
#     với quyền **Editor**. Bỏ qua bước này là lỗi hay gặp nhất.
#  6. Dán KEY và nội dung file JSON vào dưới đây.
#
# App tự tạo hai tab `trades` và `decisions` trong lần đẩy đầu tiên.
GOOGLE_SHEET_KEY = ""

[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
# Giữ nguyên các ký tự \n theo nghĩa đen, để trong một dòng, trong ngoặc kép:
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = ""
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""
universe_domain = "googleapis.com"

# ══════════════════════════════════════════════════════════════════════
# TRIỂN KHAI TRÊN STREAMLIT CLOUD
# File này KHÔNG được đẩy lên. Vào app trên share.streamlit.io:
#   Manage app → Settings → Secrets → dán cùng nội dung (dạng TOML)
# ══════════════════════════════════════════════════════════════════════
